APP_NAME=travel-agent
DEBUG=true

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_agent

# Generate your own for each environment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=39c2e6c21b2d194bcff304d23d4ea0059b90d5cd1a56b36237d687fad14a183f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Duffel flight search API
DUFFEL_API_KEY=duffel_test_replace_me
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=30

# parse.bot hotel search (hotels.com scraper) — get a key from your parse.bot dashboard
PARSEBOT_API_KEY=
PARSEBOT_API_URL=https://api.parse.bot
PARSEBOT_HOTEL_SCRAPER_ID=fa8d38aa-36ba-45d4-8191-f30d2d2e3c46
PARSEBOT_TIMEOUT_SECONDS=60

GEMINI_API_KEY=

# parse.bot redbus scraper (redbus.com scraper) — get a key from your parse.bot dashboard
PARSEBOT_REDBUS_SCRAPER_ID=35a9b6fe-4009-43dd-89e2-993f11b60ad0
# Gemini RAG assistant settings. Changing the embedding model or dimensions
# requires re-running: uv run python scripts/ingest_documents.py
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_CHAT_MODEL=gemini-3.6-flash
DOCUMENTS_DIR=data/policies
VECTOR_COLLECTION_NAME=travel_policies

# Browser origins allowed to call this API (comma-separated, no spaces).
# Cookie auth means these must be exact — "*" will not work.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
