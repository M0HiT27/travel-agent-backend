APP_NAME=travel-agent
DEBUG=true

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_agent

# Generate your own for each environment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=39c2e6c21b2d194bcff304d23d4ea0059b90d5cd1a56b36237d687fad14a183f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated origins allowed to call this API with the auth cookie.
# Add your React dev server's origin here if it's not one of these defaults.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Duffel flight search API
DUFFEL_API_KEY=duffel_test_replace_me
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=30

# parse.bot hotel search (hotels.com scraper) — get a key from your parse.bot dashboard
PARSEBOT_API_KEY=
PARSEBOT_API_URL=https://api.parse.bot
PARSEBOT_HOTEL_SCRAPER_ID=fa8d38aa-36ba-45d4-8191-f30d2d2e3c46
PARSEBOT_TIMEOUT_SECONDS=60

# parse.bot redbus scraper (redbus.com scraper) — get a key from your parse.bot dashboard
PARSEBOT_REDBUS_SCRAPER_ID=35a9b6fe-4009-43dd-89e2-993f11b60ad0

# SUPERSEDED by the LITELLM_* vars below -- chat/embeddings now go through a local
# LiteLLM proxy instead of calling a provider SDK directly, so these are no longer
# read by the app. Left here (commented out) as an easy revert, not because they
# still do anything.
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Chat + embeddings both go through a local LiteLLM proxy (OpenAI-compatible).
# Provider selection and fallback behaviour live in the proxy's own config, not
# here -- LITELLM_REASONING_MODEL_NAME / LITELLM_EMBEDDING_MODEL_NAME are whatever
# model aliases you registered in that config, not a raw provider model name.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_REASONING_MODEL_NAME=reasoning-model
LITELLM_EMBEDDING_MODEL_NAME=embedding-model